[Unit]
Description=Telegram Laptop Files bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/snikmas/work/vibecoding-projects/telegram-laptop-files
EnvironmentFile=%h/.config/telegram-laptop-files/env
ExecStart=/home/snikmas/work/vibecoding-projects/telegram-laptop-files/.venv/bin/telegram-laptop-files --config /home/snikmas/work/vibecoding-projects/telegram-laptop-files/config.local.yaml --require-token
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
