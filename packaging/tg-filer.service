[Unit]
Description=tg-filer bot
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h/.config/tg-filer
EnvironmentFile=%h/.config/tg-filer/env
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin
ExecStart=/usr/bin/env tg-filer --config %h/.config/tg-filer/config.yaml --env-file %h/.config/tg-filer/env --require-token
Restart=always
RestartSec=15

[Install]
WantedBy=default.target
